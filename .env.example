# Build Software Factory — the variables this repository's own code reads.
#
# Nothing here is needed to run the tests. These are for running the factory
# against a repo, or the dashboard against a factory. Copy to .env.local and
# fill in; .env* is gitignored.

# --------------------------------------------------------------- the App
# From the GitHub App the setup skill creates. The private key is a secret:
# it goes in the repo's Actions secrets, never in a file that is committed.
FACTORY_APP_CLIENT_ID=
FACTORY_APP_PRIVATE_KEY=
# The App's bot logins, comma-separated, as `<slug>[bot]`. `bsf audit` warns
# when these drift from the App's actual slug — renaming an App changes it.
FACTORY_APP_LOGINS=

# ------------------------------------------------------------- the model
# The harness's own key (ANTHROPIC_API_KEY, CURSOR_API_KEY, …) is read by the
# harness, not by this code. These are what the runner itself reads.
FACTORY_MODEL=
# The model the scorers and benchmark graders run on, in promptfoo's notation.
FACTORY_GRADER_PROVIDER=anthropic:messages:claude-opus-5

# ---------------------------------------------------------- the harness
# How to start the coding agent for a benchmark run. Set by the adapter; only
# needed when running a benchmark outside a workflow.
FACTORY_HARNESS_COMMAND=
FACTORY_HARNESS_ARGS=

# -------------------------------------------------------- benchmarking
# The repo a benchmark task's worktree is taken from, and how long one task
# may run before it is given up on.
FACTORY_BENCHMARK_REPO=
FACTORY_BENCHMARK_TIMEOUT_MS=1800000
# The runner binary the benchmark provider invokes. Defaults to `bsf`.
FACTORY_RUNNER=

# ------------------------------------------------------------ dashboard
# The sign-in Worker's origin. Unset means the dashboard asks for a token
# directly instead, which is the self-hosted default.
NEXT_PUBLIC_SIGNIN_WORKER=

# ---------------------------------------------------------------- tests
# Set by create-app.mjs's own tests so the script does not open a browser.
BSF_CREATE_APP_RUN=
