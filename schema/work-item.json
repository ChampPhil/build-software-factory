{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://build-software-factory.dev/schema/work-item.json",
  "title": "Work item",
  "description": "One standard work item, written by intake from any trigger. Doc 09.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "created_at",
    "source",
    "trigger_class",
    "pipeline",
    "title",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "work-item/1"
    },
    "id": {
      "$ref": "_common.json#/$defs/workItemId"
    },
    "created_at": {
      "$ref": "_common.json#/$defs/timestamp"
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "actor"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "issue",
            "issue_comment",
            "review_comment",
            "pr",
            "schedule",
            "ci_failure",
            "dashboard",
            "review",
            "gardener",
            "conflict",
            "correction",
            "practice"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "via": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "slack",
            "linear",
            "sentry",
            null
          ]
        }
      }
    },
    "trigger_class": {
      "$ref": "_common.json#/$defs/triggerClass"
    },
    "pipeline": {
      "$ref": "_common.json#/$defs/pipeline"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": [
        "string",
        "null"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "high",
        "normal"
      ],
      "default": "normal"
    },
    "fingerprint": {
      "$ref": "_common.json#/$defs/sha256"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "in_review",
        "queued_to_merge",
        "merged",
        "escalated",
        "duplicate",
        "rejected",
        "waiting_trust",
        "needs_info"
      ]
    },
    "triage_reason": {
      "type": "string",
      "description": "Why triage ended the run, in the words the author is shown. Set for needs_info (the question), out_of_scope and duplicate. The factory posts this to the source thread itself, and a job that runs whatever happened to the roles reads it back \u2014 so a run whose role died still tells whoever asked for it what became of their request."
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "_common.json#/$defs/runId"
      }
    },
    "pr": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "parent": {
      "oneOf": [
        {
          "$ref": "_common.json#/$defs/workItemId"
        },
        {
          "type": "null"
        }
      ]
    },
    "related": {
      "type": "array",
      "items": {
        "$ref": "_common.json#/$defs/workItemId"
      }
    },
    "spec": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "plan",
            "acceptance_checks"
          ],
          "additionalProperties": false,
          "properties": {
            "plan": {
              "type": "string",
              "minLength": 1
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "feature_folders": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "acceptance_checks": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "ui_change": {
              "type": "boolean",
              "description": "True when the change alters anything a person sees or does in a browser. The PR must then carry a video of it working, and fails its check without one."
            },
            "tests_added": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tests_changed": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Existing test files this build may modify or delete. The policy check fails any other test edit."
            },
            "research": {
              "description": "What the spec found and where, one entry per finding its decisions rest on. A source starts with a reference \u2014 a repo path or path:line, an http(s) URL, or \"ran: <command>\" for an experiment the spec ran \u2014 optionally followed by a note.",
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "claim",
                  "source"
                ],
                "additionalProperties": false,
                "properties": {
                  "claim": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "merged_at": {
      "$ref": "_common.json#/$defs/timestamp",
      "description": "When the item's PR merged. Set when the PR closes merged."
    },
    "closed_at": {
      "$ref": "_common.json#/$defs/timestamp",
      "description": "When the item's PR closed without merging."
    },
    "previous_prs": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "description": "PRs this item had before its current one: each was rebuilt on main as the next after it conflicted. An approval on one carries to the next when the rebuilt change adds the same lines and removes nothing new."
    },
    "requeues": {
      "type": "integer",
      "minimum": 0,
      "description": "How many times a run ended without finishing and the factory put this item back in the queue. At 2 it stops and asks a person."
    },
    "goal": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 600,
      "description": "What should be true when the work is done, in the requester's words. Optional."
    },
    "success_check": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 600,
      "description": "One concrete check that proves the goal. Written by the chief of staff. Optional."
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "reason",
        "at"
      ],
      "description": "Who chose this item's pipeline and why. Optional.",
      "properties": {
        "by": {
          "enum": [
            "chief_of_staff",
            "table",
            "person"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 400
        },
        "at": {
          "$ref": "_common.json#/$defs/timestamp"
        },
        "from": {
          "type": "string"
        },
        "pending": {
          "type": "boolean"
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "by",
              "from",
              "to"
            ],
            "properties": {
              "at": {
                "$ref": "_common.json#/$defs/timestamp"
              },
              "by": {
                "type": "string"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
